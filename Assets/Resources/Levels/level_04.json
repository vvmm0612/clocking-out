    {
      "shift": "graveyard",
      "facts": ["tank_brim", "show:tank_level=almost_full", "show:freight@siding"]
    }
  ],
  "anchors": ["box", "tower", "platform", "timetable", "rulebook", "tank", "roster", "lever", "brazier", "telegram", "signalman", "stationmaster", "express", "freight", "siding", "signal_arm", "track", "bridge"],
  "clues": [
    {
      "anchor": "timetable",
      "text": "9:30 PM freight — holds on the siding until dawn. 11:59 PM express — does not stop.",
      "minRejects": 0
    },
    {
      "anchor": "rulebook",
      "text": "Rule 14: a driver MUST stop when the WATER STOP arm is out.",
      "minRejects": 0
    },
    {
      "anchor": "tank",
      "text": "The float raises the WATER STOP arm when the tank is brim-full. The pump tops it up through the night, but never quite to the brim.",
      "minRejects": 0
    },
    {
      "anchor": "roster",
      "text": "Evening & Night shifts: signalman (box), stationmaster (platform). Graveyard shift, 11 PM till dawn: unstaffed since the budget cuts.",
      "minRejects": 0
    },
    {
      "anchor": "lever",
      "text": "Points lever. Shifts the express onto the siding.",
      "minRejects": 0
    },
    {
      "anchor": "brazier",
      "text": "Lit every evening. Every driver knows it.",
      "minRejects": 0
    },
    {
      "anchor": "telegram",
      "text": "BRIDGE OUT. Nobody has told the express.",
      "minRejects": 0
    }
  ],
