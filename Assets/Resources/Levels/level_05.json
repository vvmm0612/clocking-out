  "clues": [
    {
      "anchor": "round_sheet",
      "text": "WATCHMAN'S ROUND — 9 PM Gear Room: check the lamp. 10 PM Belfry: open the hatch, grease the bell. 11 PM Pit: bail out the rainwater. Midnight Gear Room: wind the clock. Leave the hatch open till morning.",
      "minRejects": 0
    },
    {
      "anchor": "gears",
      "text": "Solid brass. A dropped spanner once stopped it for a week.",
      "minRejects": 0
    },
    {
      "anchor": "pendulum",
      "text": "Two hundred pounds of lead. It stops for nothing.",
      "minRejects": 0
    },
    {
      "anchor": "minute_hand",
      "text": "Thin copper. Not built to hold a man.",
      "minRejects": 0
    },
    {
      "anchor": "hatch",
      "text": "Opens straight onto the gear train below.",
      "minRejects": 0
    }
  ],
